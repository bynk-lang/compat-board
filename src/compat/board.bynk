context compat.board

uses compat.model
uses compat.page

-- The Bynk compatibility board: the org canary POSTs each run's result here,
-- authenticated by the run's GitHub OIDC token (`POST /v2/runs`), and the
-- board shows the latest result per repository and Bynk version, as JSON
-- (`GET /board.json`) and as a page (`GET /`).
---
A canary run, as GitHub Actions' OIDC token names it in `sub`: a run on a
branch of a bynk-lang repository. GitHub has two formats. Repositories
created before 15 July 2026 use `repo:bynk-lang/NAME:ref:refs/heads/BRANCH`;
later ones add the owner's and repository's immutable IDs,
`repo:bynk-lang@295025398/NAME@ID:ref:refs/heads/BRANCH`. A pull request's
run (`…:pull_request`) is not a canary run.
---
type RunSubject = String where Matches("repo:bynk-lang(?:@295025398)?/[A-Za-z0-9._-]+(?:@[0-9]+)?:ref:refs/heads/.+")

---
A canary run authenticated by the GitHub Actions OIDC token it mints for
this board's URL. No secret: the trust root is GitHub's public key set.
The run's repository is in its identity, so a report can only be for the
repository that sent it.
---
actor CanaryRun {
	auth = Oidc(
		issuer = "https://token.actions.githubusercontent.com",
		audience = "https://compat-board.accuser.workers.dev",
		jwks = "https://token.actions.githubusercontent.com/.well-known/jwks"
	),
	identity = RunSubject
}

---
The `owner/name` a run's subject names, whichever format it's in: the
`repo:` prefix and any `@ID` suffixes are dropped.
---
fn subjectRepo(subject: String) -> String {
	let path = subject.split(":").skip(1).first().getOrElse("")
	let parts = path.split("/")
	let owner = parts.first().getOrElse("").split("@").first().getOrElse("")
	let name = parts.skip(1).first().getOrElse("").split("@").first().getOrElse("")
	"\(owner)/\(name)"
}

---
What `POST /v2/runs` answers: whether this report changed the board. A retried
report (the same `run_url`) or one older than the result already held
changes nothing.
---
type Ack = { stored: Bool }

---
The board as JSON: every result held, one per repository and version.
---
type BoardView = { runs: List[Run] }

---
The key the board keeps a result under: one result per repository and
version.
---
fn slot(repo: Repo, version: Version) -> String { "\(repo)#\(version)" }

---
The one board. Every write goes through this single instance, so a report is
compared with the result it would replace and stored in one step.
---
agent Board {
	key id: String

	store latest: Map[String, Run]

	---
	Stores a report if it is the first for its repository and version, or
	strictly newer than the result held. A retried report has the same
	`finished_at` as the result it would replace, so it changes nothing.
	---
	on call save(run: Run) -> Effect[Bool] {
		let key = slot(run.repo, run.bynk_version)
		let held <- latest.get(key)
		let newer = match held {
			Some(h) => run.finished_at > h.finished_at,
			None => true,
		}
		if newer {
			let _ <- latest.put(key, run)
			true
		} else {
			false
		}
	}

	on call all() -> Effect[List[Run]] { latest.values.collect() }

	on call size() -> Effect[Int] { latest.size() }
}

service api from http {
	---
	Records a canary run's result, authenticated by the run's OIDC token.
	`403` if the report is for a different repository than the run that sent
	it.
	---
	on POST("/v2/runs") (body: Run) -> Effect[HttpResult[Ack]] by run: CanaryRun {
		if subjectRepo("\(run.identity)") != "\(body.repo)" {
			Forbidden
		} else {
			let stored <- Board("main").save(body)
			if stored { Created(Ack { stored: true }) } else { Ok(Ack { stored: false }) }
		}
	}

	on GET("/board.json") () -> Effect[HttpResult[BoardView]] by Visitor {
		let runs <- Board("main").all()
		Ok(BoardView { runs: runs })
	}

	on GET("/") () -> Effect[HttpResult[()]] by Visitor {
		let runs <- Board("main").all()
		Raw(Bytes.fromUtf8(render(runs, 8)), "text/html; charset=utf-8")
	}
}
