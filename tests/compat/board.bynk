suite compat.board {
	case "a new report is stored" {
		let r <- api.POST("/runs", Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.4",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}) by Canary
		expect r is Created(_)
		let n <- Board("main").size()
		expect n == 1
	}

	case "a retried report changes nothing" {
		let run = Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.4",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}
		let first <- api.POST("/runs", run) by Canary
		let again <- api.POST("/runs", run) by Canary
		expect first is Created(_)
		expect again is Ok(_)
		let n <- Board("main").size()
		expect n == 1
	}

	case "a newer run replaces the result for its repository and version" {
		let old = Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.4",
			result: "fail",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}
		let new = Run {
			...old,
			result: "pass",
			run_url: "https://github.com/bynk-lang/a/actions/runs/2",
			finished_at: "2026-10-07T13:00:00Z",
		}
		let a <- api.POST("/runs", old) by Canary
		let b <- api.POST("/runs", new) by Canary
		expect b is Created(_)
		let runs <- Board("main").all()
		expect runs.count() == 1
		expect runs.filter((r) => r.result == "pass").count() == 1
	}

	case "an older run arriving late does not replace a newer one" {
		let new = Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.4",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/2",
			finished_at: "2026-10-07T13:00:00Z",
		}
		let old = Run {
			...new,
			result: "fail",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}
		let a <- api.POST("/runs", new) by Canary
		let b <- api.POST("/runs", old) by Canary
		expect b is Ok(_)
		let runs <- Board("main").all()
		expect runs.filter((r) => r.result == "pass").count() == 1
	}

	case "a different run finishing in the same second changes nothing" {
		let first = Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.4",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}
		let second = Run {
			...first,
			result: "fail",
			run_url: "https://github.com/bynk-lang/a/actions/runs/2",
		}
		let a <- api.POST("/runs", first) by Canary
		let b <- api.POST("/runs", second) by Canary
		expect b is Ok(_)
		let runs <- Board("main").all()
		expect runs.filter((r) => r.result == "pass").count() == 1
	}

	case "each version keeps its own result" {
		let a = Run {
			repo: "bynk-lang/a",
			kind: "example",
			bynk_version: "0.309.3",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/a/actions/runs/1",
			finished_at: "2026-10-07T12:00:00Z",
		}
		let b = Run {
			...a,
			bynk_version: "0.309.4",
			run_url: "https://github.com/bynk-lang/a/actions/runs/2",
		}
		let x <- api.POST("/runs", a) by Canary
		let y <- api.POST("/runs", b) by Canary
		let n <- Board("main").size()
		expect n == 2
	}

	case "the board is public, as JSON and as a page" {
		let j <- api.GET("/board.json") by Visitor
		expect j is Ok(_)
		let p <- api.GET("/") by Visitor
		expect p is Raw(_, _)
	}

	case "a subject names its repository in either GitHub format" {
		expect subjectRepo("repo:bynk-lang/bynk-ci:ref:refs/heads/main") == "bynk-lang/bynk-ci"
		expect subjectRepo(
			"repo:bynk-lang@295025398/compat-board@1409010265:ref:refs/heads/main"
		) == "bynk-lang/compat-board"
		expect subjectRepo(
			"repo:bynk-lang/compat-board:ref:refs/heads/feature/x:y"
		) == "bynk-lang/compat-board"
	}

	case "a run's OIDC report for its own repository is stored" {
		let r <- api.POST("/v2/runs", Run {
			repo: "bynk-lang/compat-board",
			kind: "example",
			bynk_version: "0.314.23",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/compat-board/actions/runs/1",
			finished_at: "2026-10-10T12:00:00Z",
		}) by CanaryRun("repo:bynk-lang@295025398/compat-board@1409010265:ref:refs/heads/main")
		expect r is Created(_)
		let n <- Board("main").size()
		expect n == 1
	}

	case "an old-format subject reports for its repository too, and a retry changes nothing" {
		let run = Run {
			repo: "bynk-lang/bynk-ci",
			kind: "action",
			bynk_version: "0.314.23",
			result: "pass",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/bynk-ci/actions/runs/7",
			finished_at: "2026-10-10T12:00:00Z",
		}
		let first <- api.POST(
			"/v2/runs",
			run
		) by CanaryRun("repo:bynk-lang/bynk-ci:ref:refs/heads/main")
		let again <- api.POST(
			"/v2/runs",
			run
		) by CanaryRun("repo:bynk-lang/bynk-ci:ref:refs/heads/main")
		expect first is Created(_)
		expect again is Ok(_)
	}

	case "a run can't report for another repository" {
		let r <- api.POST("/v2/runs", Run {
			repo: "bynk-lang/compat-board",
			kind: "example",
			bynk_version: "0.314.23",
			result: "fail",
			commit: "0123456789abcdef0123456789abcdef01234567",
			run_url: "https://github.com/bynk-lang/bynk-ci/actions/runs/8",
			finished_at: "2026-10-10T12:00:00Z",
		}) by CanaryRun("repo:bynk-lang/bynk-ci:ref:refs/heads/main")
		expect r is Forbidden
		let n <- Board("main").size()
		expect n == 0
	}
}
